# 统一换行与文本属性（仓库内一律 LF，避免跨平台差异）
* text=auto eol=lf

# 显式声明文本类型
*.html   text eol=lf
*.htm    text eol=lf
*.xhtml  text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.xml    text eol=lf
*.svg    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.log    text eol=lf
*.lst    text eol=lf
*.ini    text eol=lf
*.ps1    text eol=lf

# 二进制文件：禁止行尾与文本转换
*.z      binary
*.zip    binary
*.gz     binary
*.7z     binary
*.rar    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.bmp    binary
*.tif    binary
*.tiff   binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.otf    binary
*.pdf    binary
